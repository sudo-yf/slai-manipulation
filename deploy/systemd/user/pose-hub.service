[Unit]
Description=SLaI iPhone Pose Hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/shiyi/slai-manipulation
EnvironmentFile=%h/.config/pose-hub/pose-hub.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/shiyi/slai-manipulation/src
ExecStart=%h/shiyi/slai-manipulation/.venv/bin/python -m slai_mi.apps.pose_hub --run --host 100.73.226.20 --port 8706
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=default.target
